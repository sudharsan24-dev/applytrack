# Local SQLite is the default. Change to mysql for the resume stack.
DB_DRIVER=sqlite
PORT=3001
HOST=127.0.0.1
APP_ORIGIN=http://localhost:5173
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=applytrack
MYSQL_PASSWORD=replace-with-your-local-password
MYSQL_DATABASE=applytrack
# Set NODE_ENV=production when deploying behind HTTPS.
